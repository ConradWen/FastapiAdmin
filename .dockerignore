# ============================================
# FastapiAdmin .dockerignore
# 用于优化 Docker 构建上下文，提升构建速度
# ============================================

# Python 缓存
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.mypy_cache
.ruff_cache

# 虚拟环境
venv
.venv
# 环境变量文件：必须排除所有真实密钥文件（.env 只能匹配到名为 .env 的文件，
# 匹配不到 .env.prod / .env.dev / .env.test —— 它们含真实口令与 API Key）
.env
**/.env
**/.env.*
!**/.env.example

# 编辑器/IDE
.vscode
.idea
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db

# 版本控制
.git
.gitignore
.gitattributes

# 日志
logs
*.log

# 数据库
*.db
*.sqlite3

# 前端工程（后端镜像不需要）
frontend

# 部署脚本
deploy.sh
deploy.bat

# 文档
README.md
README.en.md
LICENSE

# 数据库迁移（构建镜像时不包含，启动时动态执行）
# 取消注释以加速构建：backend/alembic/versions
# 用户上传文件（本地存储源根目录）不进镜像；static/image、static/swagger 是程序资源必须保留
backend/static/upload
